---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../data/site.json';
import aboutData from '../data/about.json';
import timeline from '../data/timeline.json';
import news from '../data/news.json';
import videos from '../data/videos.json';
import speeches from '../data/speeches.json';

const featuredNews = news.filter(n => n.featured).slice(0, 1);
const recentNews = news.filter(n => !n.featured).slice(0, 3);

// Campaign videos (first 3 videos)
const campaignVideos = videos.filter(v => v.category === 'নির্বাচনী প্রচারণা').slice(0, 3);

// Latest speeches (first 3)
const latestSpeeches = speeches.slice(0, 3);
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="hero" style="padding-bottom:0">
    <div class="wrap">
      <div>
        <span class="tag">অফিসিয়াল ওয়েবসাইট</span>
        <h1>মাহফুজ কবির <em>মুক্তা</em></h1>
        <p>
          প্রেস অফিসার, ইশরাক হোসেন এমপি ও সাবেক প্রতিমন্ত্রী, মুক্তিযুদ্ধ বিষয়ক মন্ত্রণালয়। 
          তথ্যপ্রযুক্তি সংগঠক এবং ভিওডি বাংলা'র সহ-প্রতিষ্ঠাতা।
        </p>
        <div class="cta">
          <a class="btn btn-gold" href="/about">আমার পরিচিতি →</a>
          <a class="btn btn-line" href="/contact">যোগাযোগ করুন</a>
        </div>
      </div>
      <div class="portrait">
        <img 
          src="/images/hero-portrait.jpg" 
          alt="মাহফুজ কবির মুক্তা"
          width="540"
          height="520"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Quick Links -->
  <section class="quick">
    <div class="wrap qgrid">
      <a class="q rv" href="/about">
        <i>
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </i>
        <b>পরিচিতি</b>
        <small>জীবন ও কর্মযাত্রা</small>
      </a>
      <a class="q rv" href="/vision">
        <i>
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <circle cx="12" cy="12" r="6"></circle>
            <circle cx="12" cy="12" r="2"></circle>
          </svg>
        </i>
        <b>লক্ষ্য ও পরিকল্পনা</b>
        <small>আগামীর ভাবনা</small>
      </a>
      <a class="q rv" href="/join">
        <i>
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <line x1="19" y1="8" x2="19" y2="14"></line>
            <line x1="22" y1="11" x2="16" y2="11"></line>
          </svg>
        </i>
        <b>স্বেচ্ছাসেবক</b>
        <small>আমাদের সাথে যুক্ত হোন</small>
      </a>
      <a class="q rv" href="/videos">
        <i>
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="23 7 16 12 23 17 23 7"></polygon>
            <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
          </svg>
        </i>
        <b>ভিডিও</b>
        <small>সাম্প্রতিক কার্যক্রম</small>
      </a>
    </div>
  </section>

  <!-- About Section -->
  <section id="about">
    <div class="wrap about">
      <div class="about-img rv">
        <img 
          src={`/images/${aboutData.image.main}`}
          alt={aboutData.image.alt.bn}
          width="480"
          height="640"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="rv">
        <span class="eyebrow">{aboutData.eyebrow.bn}</span>
        <h2 class="h2">তথ্য, প্রযুক্তি ও সংগঠনের পথে এক দীর্ঘ যাত্রা</h2>
        {aboutData.paragraphs.slice(0, 2).map(para => (
          <p>{para.bn}</p>
        ))}
        <a class="btn btn-gold" href="/about">বিস্তারিত পড়ুন →</a>
      </div>
    </div>
  </section>

  <!-- Timeline Section -->
  <section class="tl-bg" id="journey">
    <div class="wrap">
      <span class="eyebrow">কর্মযাত্রা</span>
      <h2 class="h2">দায়িত্ব ও অবদান</h2>
      <p class="lead">সময়ের সাথে বিভিন্ন প্রতিষ্ঠান ও সংগঠনে দায়িত্ব পালনের সংক্ষিপ্ত চিত্র।</p>
      <div class="tl">
        {timeline.slice(0, 5).map(item => (
          <article class="rv tl-card">
            {item.logo && (
              <div class="tl-badge">
                <img 
                  src={`/images/logos/${item.logo}`}
                  alt={item.logoAlt.bn}
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="tl-content">
              <time>{item.date.bn}</time>
              <h3>{item.title.bn}</h3>
              <p>{item.organization.bn}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Vision Section -->
  <section id="vision">
    <div class="wrap">
      <span class="eyebrow">লক্ষ্য ও পরিকল্পনা</span>
      <h2 class="h2">যেসব বিষয়ে আমরা কাজ করছি</h2>
      <p class="lead">
        [নিচের কার্ডগুলোর বিষয় ও লেখা মালিকের নিশ্চিত তথ্য দিয়ে প্রতিস্থাপন করতে হবে]
      </p>
      <div class="pgrid">
        <article class="pc rv">
          <div class="pc-img">
            <img 
              src="/images/pledge-1.jpg" 
              alt="তথ্য ও প্রযুক্তি"
              width="400"
              height="190"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="b">
            <h3>তথ্য ও প্রযুক্তি</h3>
            <p>ডিজিটাল গণমাধ্যম ও প্রযুক্তিনির্ভর যোগাযোগ।</p>
            <a class="more" href="/vision#technology">
              আরও জানুন →
            </a>
          </div>
        </article>
        
        <article class="pc rv">
          <div class="pc-img">
            <img 
              src="/images/pledge-2.jpg" 
              alt="তরুণ ও যুব উন্নয়ন"
              width="400"
              height="190"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="b">
            <h3>তরুণ ও যুব উন্নয়ন</h3>
            <p>তরুণদের দক্ষতা ও নেতৃত্ব বিকাশ।</p>
            <a class="more" href="/vision#youth">
              আরও জানুন →
            </a>
          </div>
        </article>
        
        <article class="pc rv">
          <div class="pc-img">
            <img 
              src="/images/pledge-3.jpg" 
              alt="মুক্তিযুদ্ধের চেতনা"
              width="400"
              height="190"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="b">
            <h3>মুক্তিযুদ্ধের চেতনা</h3>
            <p>ইতিহাস ও চেতনা সংরক্ষণ ও প্রচার।</p>
            <a class="more" href="/vision#liberation">
              আরও জানুন →
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Campaign Videos Strip -->
  {campaignVideos.length > 0 && (
    <section id="campaign" style="background:var(--cream)">
      <div class="wrap">
        <span class="eyebrow">নির্বাচনী প্রচারণা</span>
        <h2 class="h2">সাম্প্রতিক প্রচারণা কার্যক্রম</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;margin-top:32px">
          {campaignVideos.map(video => (
            <article class="video-card-mini rv">
              <div class="yt-lite" data-id={video.id} data-start={video.startSeconds || 0}>
                <img 
                  src={video.thumbnail}
                  alt={video.title.bn}
                  width="480"
                  height="270"
                  loading="lazy"
                  decoding="async"
                />
                <button type="button" class="yt-play-mini" aria-label="ভিডিও চালান">
                  <svg width="48" height="34" viewBox="0 0 68 48"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="red"/><path d="M45 24L27 14v20" fill="white"/></svg>
                </button>
              </div>
              <h3 style="font-size:16px;margin-top:12px;color:var(--deep-green)">{video.title.bn}</h3>
            </article>
          ))}
        </div>
        <p style="margin-top:32px;text-align:center">
          <a class="btn btn-gold" href="/videos">সব ভিডিও দেখুন →</a>
        </p>
      </div>
    </section>
  )}

  <!-- Speeches Section -->
  {latestSpeeches.length > 0 && (
    <section id="speeches">
      <div class="wrap">
        <span class="eyebrow">বক্তব্য</span>
        <h2 class="h2">সাম্প্রতিক বক্তৃতা</h2>
        <div style="display:grid;gap:24px;margin-top:32px">
          {latestSpeeches.map(speech => (
            <article class="speech-card-mini rv" style="display:grid;grid-template-columns:200px 1fr;gap:20px;background:white;padding:24px;border-radius:8px;box-shadow:0 2px 8px rgba(10,61,46,0.08)">
              <div class="yt-lite" data-id={speech.id} data-start={0} style="border-radius:6px;overflow:hidden">
                <img 
                  src={speech.thumbnail}
                  alt={speech.title.bn}
                  width="200"
                  height="113"
                  loading="lazy"
                  decoding="async"
                />
                <button type="button" class="yt-play-mini" aria-label="ভিডিও চালান">
                  <svg width="48" height="34" viewBox="0 0 68 48"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="red"/><path d="M45 24L27 14v20" fill="white"/></svg>
                </button>
              </div>
              <div>
                <span style="display:inline-block;padding:4px 12px;background:var(--cream);color:var(--deep-green);border-radius:4px;font-size:13px;font-weight:500;margin-bottom:8px">{speech.category}</span>
                <h3 style="font-size:18px;margin-bottom:8px;color:var(--deep-green)">{speech.title.bn}</h3>
                <p style="color:#666;font-size:15px;line-height:1.6">{speech.description.bn}</p>
              </div>
            </article>
          ))}
        </div>
        <p style="margin-top:32px;text-align:center">
          <a class="btn btn-gold" href="/speeches">সব বক্তব্য দেখুন →</a>
        </p>
      </div>
    </section>
  )}

  <!-- Quote Section -->
  <section class="quote">
    <div class="wrap rv">
      <blockquote>
        {siteData.slogan.bn}
        <cite>{siteData.attribution.bn}</cite>
      </blockquote>
      <a class="btn btn-gold" href="/join">স্বেচ্ছাসেবক হোন</a>
    </div>
  </section>

  <!-- News Section -->
  <section id="news">
    <div class="wrap">
      <div class="news-header">
        <div>
          <span class="eyebrow">মিডিয়া</span>
          <h2 class="h2">সর্বশেষ সংবাদ ও আপডেট</h2>
        </div>
        <a class="btn btn-gold news-view-all" href="/news">সব সংবাদ দেখুন →</a>
      </div>
      <div class="ngrid">
        {featuredNews.map(article => (
          <article class="nbig rv">
            <a href={`/news/${article.slug}`} class="nbig-img">
              <img 
                src={`/images/${article.image}`}
                alt={article.imageAlt?.bn || article.title.bn}
                width="700"
                height="394"
                loading="lazy"
                decoding="async"
                onerror="this.src='/images/fallback-news.jpg';this.onerror=null;"
              />
              <div class="nbig-overlay">
                <span class="news-category">{article.category.bn}</span>
                {article.type === 'video' && (
                  <span class="news-source">{article.source.label.bn}</span>
                )}
                <h3>{article.title.bn}</h3>
                {article.type === 'video' && (
                  <div class="play-badge" aria-label="ভিডিও">
                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                      <circle cx="24" cy="24" r="24" fill="rgba(232, 168, 58, 0.9)"/>
                      <path d="M32 24L18 32V16L32 24Z" fill="white"/>
                    </svg>
                  </div>
                )}
              </div>
            </a>
          </article>
        ))}
        
        <div class="nlist">
          {recentNews.map(article => (
            <article class="ni rv">
              <a href={`/news/${article.slug}`} class="ni-img">
                <img 
                  src={`/images/${article.image}`}
                  alt={article.imageAlt?.bn || article.title.bn}
                  width="120"
                  height="90"
                  loading="lazy"
                  decoding="async"
                  onerror="this.src='/images/fallback-news-thumb.jpg';this.onerror=null;"
                />
                {article.type === 'video' && (
                  <div class="play-badge-small" aria-label="ভিডিও">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="12" r="12" fill="rgba(232, 168, 58, 0.95)"/>
                      <path d="M16 12L9 16V8L16 12Z" fill="white"/>
                    </svg>
                  </div>
                )}
              </a>
              <div class="ni-content">
                <span class="news-category-sm">{article.category.bn}</span>
                {article.type === 'video' && (
                  <span class="news-source-sm">{article.source.label.bn}</span>
                )}
                <h3><a href={`/news/${article.slug}`}>{article.title.bn}</a></h3>
              </div>
            </article>
          ))}
        </div>
      </div>
      <p class="news-view-all-mobile" style="margin-top:28px;text-align:center">
        <a class="btn btn-gold" href="/news">সব সংবাদ দেখুন →</a>
      </p>
    </div>
  </section>

  <!-- Subscribe Section -->
  <section style="padding-top:0">
    <div class="wrap">
      <div class="sub rv">
        <h2>সর্বশেষ খবর পেতে সাবস্ক্রাইব করুন</h2>
        <form method="POST" action={siteData.forms.newsletter || '#'} onsubmit="return false;">
          <input 
            type="email" 
            name="email"
            required 
            placeholder="আপনার ইমেইল" 
            aria-label="ইমেইল"
          />
          <button class="btn" type="submit">সাবস্ক্রাইব</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .video-card-mini .yt-lite {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    cursor: pointer;
    background: #f5f5f5;
    border-radius: 6px;
    overflow: hidden;
  }
  
  .video-card-mini .yt-lite img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .yt-play-mini {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border: none;
    background: transparent;
    cursor: pointer;
    opacity: 0.9;
    transition: opacity 0.2s;
  }
  
  .yt-play-mini:hover {
    opacity: 1;
  }
  
  .speech-card-mini:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(10, 61, 46, 0.12);
    transition: all 0.2s;
  }
  
  @media (max-width: 768px) {
    .speech-card-mini {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script>
  // YouTube lite embed for homepage videos
  document.querySelectorAll('.yt-lite').forEach(lite => {
    lite.addEventListener('click', function() {
      const videoId = this.dataset.id;
      const startSeconds = this.dataset.start || 0;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&start=${startSeconds}`;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.style.width = '100%';
      iframe.style.height = '100%';
      iframe.style.border = 'none';
      iframe.style.borderRadius = this.style.borderRadius || '0';
      this.replaceWith(iframe);
    });
  });
</script>
