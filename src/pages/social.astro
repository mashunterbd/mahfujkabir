---
import BaseLayout from '../layouts/BaseLayout.astro';
import socialData from '../data/social.json';
import videosData from '../data/videos.json';
import instagramPosts from '../data/instagram-posts.json';

const title = 'সোশ্যাল মিডিয়া | মাহফুজ কবির মুক্তা';
const description = 'মাহফুজ কবির মুক্তার সোশ্যাল মিডিয়া কার্যক্রম - YouTube, Facebook, Instagram এবং TikTok।';

const { channels, vodBangla, facebookPagePlugin } = socialData;

// Get YouTube videos (max 12 for initial grid)
const youtubeVideos = videosData.filter(v => v.platform === 'youtube').slice(0, 12);

// Generate Facebook Page Plugin embed URLs
const generateFacebookPluginUrl = (pageId: string) => {
  const params = new URLSearchParams({
    href: `https://www.facebook.com/${pageId}`,
    tabs: facebookPagePlugin.tabs,
    width: String(facebookPagePlugin.width),
    height: String(facebookPagePlugin.height),
    small_header: String(facebookPagePlugin.smallHeader),
    adapt_container_width: String(facebookPagePlugin.adaptContainerWidth),
    hide_cover: String(facebookPagePlugin.hideCover),
    show_facepile: String(facebookPagePlugin.showFacepile),
    appId: '',
    lang: facebookPagePlugin.locale
  });
  return `https://www.facebook.com/plugins/page.php?${params.toString()}`;
};

const fbPluginMain = generateFacebookPluginUrl(channels.facebook.pageId);
const fbPluginVOD = generateFacebookPluginUrl(vodBangla.facebookPageId);

// Format video duration (from seconds to MM:SS)
const formatDuration = (seconds: number) => {
  const mins = Math.floor(seconds / 60);
  const secs = seconds % 60;
  return `${mins}:${secs.toString().padStart(2, '0')}`;
};
---

<BaseLayout title={title} description={description}>
  <!-- Breadcrumbs -->
  <section class="breadcrumbs">
    <div class="wrap">
      <nav aria-label="Breadcrumb">
        <ol>
          <li><a href="/">হোম</a></li>
          <li>সোশ্যাল মিডিয়া</li>
        </ol>
      </nav>
    </div>
  </section>

  <!-- Hero -->
  <section style="padding-top:40px;padding-bottom:32px">
    <div class="wrap" style="text-align:center;max-width:780px;margin:0 auto">
      <span class="eyebrow">সোশ্যাল মিডিয়া</span>
      <h1 class="h2">ডিজিটাল অ্যাক্টিভিটি</h1>
      <p class="lead">
        সামাজিক মাধ্যমে আমার কার্যক্রম, সাম্প্রতিক ভিডিও এবং আপডেট দেখুন। আমার সাথে সংযুক্ত থাকুন।
      </p>
    </div>

    <!-- Follow Cards Grid -->
    <div style="max-width:960px;margin:40px auto 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px">
      <a href="#youtube" class="follow-card rv">
        <div class="fc-icon" style="background:#ff0000">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="#fff">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </div>
        <span>YouTube</span>
      </a>

      <a href="#facebook" class="follow-card rv">
        <div class="fc-icon" style="background:#1877f2">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="#fff">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </div>
        <span>Facebook</span>
      </a>

      <a href="#vodbangla" class="follow-card rv">
        <div class="fc-icon" style="background:var(--g8)">
          <img src="/images/logos/vodbangla.png" alt="VOD" style="width:28px;height:28px;object-fit:contain" />
        </div>
        <span>VOD Bangla</span>
      </a>

      <a href="#instagram-tiktok" class="follow-card rv">
        <div class="fc-icon" style="background:linear-gradient(45deg, #f09433 0%,#e6683c 25%,#dc2743 50%,#cc2366 75%,#bc1888 100%)">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#fff">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </div>
        <span>Instagram & TikTok</span>
      </a>
    </div>
  </section>

  <!-- Sticky Tabs -->
  <div class="social-tabs">
    <div class="wrap">
      <div class="social-tabs-inner">
        <a href="#youtube" class="social-tab active">YouTube</a>
        <a href="#facebook" class="social-tab">Facebook</a>
        <a href="#vodbangla" class="social-tab">VOD Bangla</a>
        <a href="#instagram-tiktok" class="social-tab">Instagram & TikTok</a>
      </div>
    </div>
  </div>

  <!-- YouTube Section -->
  <section class="social-section" id="youtube">
    <div class="wrap">
      <!-- Channel Header -->
      <div class="yt-channel-header rv">
        <div class="yt-ch-avatar">
          <img src="/images/hero-portrait.jpg" alt="মাহফুজ কবির মুক্তা" />
        </div>
        <div class="yt-ch-info">
          <h2>{channels.youtube.name.bn}</h2>
          <p class="yt-ch-handle">{channels.youtube.handle}</p>
          <p class="yt-ch-desc">{channels.youtube.description.bn}</p>
          <div class="yt-ch-stats">
            <span title="সাবস্ক্রাইবার">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              {youtubeVideos.length}+ ভিডিও
            </span>
            <span>•</span>
            <a href="/videos" style="color:var(--g6);font-weight:600">সম্পূর্ণ লাইব্রেরি দেখুন →</a>
          </div>
        </div>
        <div class="yt-ch-action">
          <a href={channels.youtube.url + '?sub_confirmation=1'} target="_blank" rel="noopener noreferrer" class="btn-subscribe">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            সাবস্ক্রাইব করুন
          </a>
        </div>
      </div>

      <!-- Video Grid -->
      <div class="yt-video-grid" style="margin-top:32px">
        {youtubeVideos.map(video => (
          <button 
            class="yt-video-card rv" 
            data-video-id={video.id}
            data-start={video.startSeconds || 0}
            aria-label={`ভিডিও চালান: ${video.title.bn}`}
          >
            <div class="yt-vc-thumb">
              <img 
                src={video.thumbnail} 
                alt={video.title.bn}
                loading="lazy"
              />
              <div class="yt-play-overlay">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
              </div>
              {video.aspectRatio === '9:16' && (
                <div class="yt-badge yt-badge-short">Short</div>
              )}
            </div>
            <div class="yt-vc-info">
              <h3>{video.title.bn}</h3>
              <p class="yt-vc-meta">
                <span class="yt-vc-cat">{video.category}</span>
                {video.publishedAt && (
                  <>
                    <span>•</span>
                    <time>{new Date(video.publishedAt).toLocaleDateString('bn-BD', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
                  </>
                )}
              </p>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Facebook Section -->
  <section class="social-section" id="facebook" style="background:var(--cream)">
    <div class="wrap">
      <div class="social-header">
        <div class="social-logo" style="background:#1877f2">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="#fff">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </div>
        <div class="social-info">
          <h2>Facebook পেজ</h2>
          <p>সর্বশেষ পোস্ট, ছবি এবং সাংগঠনিক কার্যক্রম</p>
        </div>
      </div>

      <!-- Dual Facebook Page Plugins -->
      <div class="fb-plugin-grid">
        <!-- Main Page -->
        <div class="fb-plugin-wrapper">
          <div class="embed-consent" data-platform="facebook-main">
            <h3 style="font-size:18px;margin-bottom:12px;color:var(--g8)">মাহফুজ কবির মুক্তা</h3>
            <p style="color:var(--mut);margin-bottom:16px;font-size:15px">
              এই কন্টেন্ট Facebook থেকে লোড হয়
            </p>
            <button class="btn btn-gold" onclick="loadFacebookMain()">ফিড লোড করুন</button>
            <a href={channels.facebook.url} target="_blank" rel="noopener noreferrer" style="display:block;margin-top:12px;color:var(--g6);font-size:14px">
              Facebook-এ দেখুন →
            </a>
          </div>
          <div id="facebook-main-embed" style="display:none"></div>
        </div>

        <!-- VOD Bangla Page -->
        <div class="fb-plugin-wrapper">
          <div class="embed-consent" data-platform="facebook-vod">
            <h3 style="font-size:18px;margin-bottom:12px;color:var(--g8)">ভিওডি বাংলা</h3>
            <p style="color:var(--mut);margin-bottom:16px;font-size:15px">
              এই কন্টেন্ট Facebook থেকে লোড হয়
            </p>
            <button class="btn btn-gold" onclick="loadFacebookVOD()">ফিড লোড করুন</button>
            <a href={vodBangla.facebook} target="_blank" rel="noopener noreferrer" style="display:block;margin-top:12px;color:var(--g6);font-size:14px">
              Facebook-এ দেখুন →
            </a>
          </div>
          <div id="facebook-vod-embed" style="display:none"></div>
        </div>
      </div>

      <div style="background:rgba(232,168,58,0.08);border:2px solid rgba(232,168,58,0.2);border-radius:var(--r);padding:16px;margin-top:24px;text-align:center">
        <p style="color:var(--g8);font-size:14px;margin:0">
          💡 <strong>দ্রষ্টব্য:</strong> ফিড লোড করতে উপরের "ফিড লোড করুন" বাটনে ক্লিক করুন। আপনার পছন্দ সংরক্ষিত থাকবে।
        </p>
      </div>
    </div>
  </section>

  <!-- VOD Bangla Section -->
  <section class="social-section" id="vodbangla">
    <div class="wrap">
      <div class="social-header">
        <div class="social-logo" style="background:white;border:2px solid var(--g8)">
          <img src="/images/logos/vodbangla.png" alt="VOD Bangla" style="width:32px;height:32px;object-fit:contain" />
        </div>
        <div class="social-info">
          <h2>ভিওডি বাংলা</h2>
          <p>{vodBangla.description.bn}</p>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;margin-top:28px">
        <!-- Website Card -->
        <div class="vod-card rv">
          <div class="vod-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <h3>অফিসিয়াল ওয়েবসাইট</h3>
          <p style="color:var(--mut);font-size:15px;margin:12px 0 16px">
            ভিওডি বাংলা-র সম্পূর্ণ কন্টেন্ট এবং তথ্য দেখুন।
          </p>
          <p class="vod-warning">⚠️ মালিকের নিশ্চিতকরণ প্রয়োজন</p>
          <a href={vodBangla.website} target="_blank" rel="noopener noreferrer" class="btn btn-line-dark" style="width:100%;text-align:center;margin-top:16px">
            ওয়েবসাইট ভিজিট করুন →
          </a>
        </div>

        <!-- Facebook Page Card (already loaded above in Facebook section) -->
        <div class="vod-card rv">
          <div class="vod-card-icon" style="background:#1877f2">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="#fff">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </div>
          <h3>Facebook পেজ</h3>
          <p style="color:var(--mut);font-size:15px;margin:12px 0 16px">
            ভিওডি বাংলা-র সর্বশেষ আপডেট এবং পোস্ট।
          </p>
          <p class="vod-warning">⚠️ মালিকের নিশ্চিতকরণ প্রয়োজন</p>
          <button class="btn btn-line-dark" style="width:100%;text-align:center;margin-top:16px" onclick="document.querySelector('#facebook').scrollIntoView({behavior:'smooth'});setTimeout(() => loadFacebookVOD(), 500)">
            পেজ ফিড দেখুন ↑
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Instagram & TikTok Section -->
  <section class="social-section" id="instagram-tiktok" style="background:var(--cream)">
    <div class="wrap">
      <div class="social-header">
        <div style="display:flex;gap:12px">
          <div class="social-logo" style="background:linear-gradient(45deg, #f09433 0%,#e6683c 25%,#dc2743 50%,#cc2366 75%,#bc1888 100%)">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="#fff">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
          <div class="social-logo" style="background:#000">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="#fff">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
            </svg>
          </div>
        </div>
        <div class="social-info">
          <h2>Instagram ও TikTok</h2>
          <p>ফটো, শর্ট ভিডিও এবং ডেইলি আপডেট</p>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px;margin-top:28px">
        <!-- Instagram Card -->
        <div class="social-profile-card rv">
          <div class="sp-header">
            <div class="sp-avatar" style="background:linear-gradient(45deg, #f09433 0%,#e6683c 25%,#dc2743 50%,#cc2366 75%,#bc1888 100%)">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="#fff">
