<style>
  /* Follow Cards */
  .follow-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 20px;
    background: white;
    border-radius: var(--r);
    box-shadow: var(--sh);
    transition: all 0.3s var(--ease);
    text-decoration: none;
    color: var(--g8);
  }

  .follow-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-lg);
  }

  .fc-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .follow-card span {
    font-weight: 600;
    font-size: 15px;
  }

  /* YouTube Channel Header */
  .yt-channel-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 20px;
    align-items: start;
    background: white;
    border-radius: var(--r);
    padding: 24px;
    box-shadow: var(--sh);
  }

  .yt-ch-avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--gold);
  }

  .yt-ch-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yt-ch-info h2 {
    font-size: 24px;
    margin-bottom: 4px;
  }

  .yt-ch-handle {
    color: var(--mut);
    font-size: 14px;
    margin-bottom: 12px;
  }

  .yt-ch-desc {
    color: var(--g8);
    font-size: 15px;
    line-height: 1.6;
    margin-bottom: 12px;
  }

  .yt-ch-stats {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--mut);
    font-size: 14px;
  }

  .yt-ch-stats svg {
    vertical-align: middle;
    margin-right: 4px;
  }

  .btn-subscribe {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: #ff0000;
    color: white;
    border-radius: 100px;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: all 0.3s var(--ease);
  }

  .btn-subscribe:hover {
    background: #cc0000;
    transform: scale(1.05);
  }

  /* YouTube Video Grid */
  .yt-video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .yt-video-card {
    background: white;
    border-radius: var(--r);
    overflow: hidden;
    box-shadow: var(--sh);
    transition: all 0.3s var(--ease);
    cursor: pointer;
    border: none;
    text-align: left;
    padding: 0;
    width: 100%;
  }

  .yt-video-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-lg);
  }

  .yt-vc-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--g8);
  }

  .yt-vc-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s var(--ease);
  }

  .yt-video-card:hover .yt-vc-thumb img {
    transform: scale(1.05);
  }

  .yt-play-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(255, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.9;
    transition: all 0.3s var(--ease);
  }

  .yt-video-card:hover .yt-play-overlay {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.1);
  }

  .yt-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 4px 8px;
    background: rgba(0, 0, 0, 0.8);
    color: white;
    font-size: 12px;
    font-weight: 600;
    border-radius: 4px;
  }

  .yt-badge-short {
    background: rgba(255, 0, 0, 0.9);
  }

  .yt-vc-info {
    padding: 16px;
  }

  .yt-vc-info h3 {
    font-size: 16px;
    line-height: 1.4;
    margin-bottom: 8px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .yt-vc-meta {
    color: var(--mut);
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .yt-vc-cat {
    background: var(--cream);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 12px;
    color: var(--g8);
    font-weight: 600;
  }

  /* Facebook Plugin Grid */
  .fb-plugin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 32px;
    margin-top: 32px;
    justify-items: center;
  }

  .fb-plugin-wrapper {
    max-width: 500px;
    width: 100%;
  }

  .fb-plugin-wrapper iframe {
    border-radius: 12px;
    box-shadow: var(--sh);
  }

  /* VOD Cards */
  .vod-card {
    background: white;
    border-radius: var(--r);
    padding: 32px 24px;
    box-shadow: var(--sh);
    text-align: center;
    transition: all 0.3s var(--ease);
  }

  .vod-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-lg);
  }

  .vod-card-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    color: var(--g8);
  }

  .vod-card h3 {
    font-size: 20px;
    margin-bottom: 12px;
  }

  .vod-warning {
    font-size: 13px;
    color: var(--gold);
    background: rgba(232, 168, 58, 0.1);
    padding: 8px 12px;
    border-radius: 6px;
    margin: 0;
  }

  /* Social Profile Cards */
  .social-profile-card {
    background: white;
    border-radius: var(--r);
    padding: 28px;
    box-shadow: var(--sh);
    transition: all 0.3s var(--ease);
  }

  .social-profile-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-lg);
  }

  .sp-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .sp-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Video Modal */
  .video-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.3s var(--ease);
  }

  .video-modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.9);
    cursor: pointer;
  }

  .video-modal-content {
    position: relative;
    width: 90vw;
    max-width: 1280px;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    z-index: 1;
  }

  .video-modal-close {
    position: absolute;
    top: -48px;
    right: 0;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.2);
    border: none;
    border-radius: 50%;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s var(--ease);
    z-index: 2;
  }

  .video-modal-close:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: scale(1.1);
  }

  #video-modal-player {
    aspect-ratio: 16 / 9;
    width: 100%;
  }

  #video-modal-player iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Responsive */
  @media (max-width: 968px) {
    .yt-channel-header {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 16px;
    }

    .yt-ch-avatar {
      margin: 0 auto;
    }

    .yt-ch-action {
      display: flex;
      justify-content: center;
    }

    .fb-plugin-grid {
      grid-template-columns: 1fr;
    }

    .yt-video-grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    }
  }

  @media (max-width: 640px) {
    .yt-video-grid {
      grid-template-columns: 1fr;
    }

    .video-modal-content {
      width: 95vw;
    }

    .fb-plugin-grid {
      gap: 24px;
    }
  }
</style>

<script define:vars={{ fbPluginMain, fbPluginVOD }}>
  // Consent Management
  let consentGiven = localStorage.getItem('socialMediaConsent') === 'true';

  // Load Facebook Main Page
  function loadFacebookMain() {
    const container = document.getElementById('facebook-main-embed');
    const consent = document.querySelector('[data-platform="facebook-main"]');
    
    if (container && consent) {
      consent.style.display = 'none';
      container.style.display = 'block';
      container.innerHTML = `
        <iframe 
          src="${fbPluginMain}"
          title="মাহফুজ কবির মুক্তা - Facebook পেজ"
          width="500"
          height="720"
          style="border:none;overflow:hidden;max-width:100%;border-radius:12px"
          scrolling="no"
          frameborder="0"
          allowfullscreen="true"
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"></iframe>
      `;
      giveConsent();
    }
  }

  // Load Facebook VOD Page
  function loadFacebookVOD() {
    const container = document.getElementById('facebook-vod-embed');
    const consent = document.querySelector('[data-platform="facebook-vod"]');
    
    if (container && consent) {
      consent.style.display = 'none';
      container.style.display = 'block';
      container.innerHTML = `
        <iframe 
          src="${fbPluginVOD}"
          title="ভিওডি বাংলা - Facebook পেজ"
          width="500"
          height="720"
          style="border:none;overflow:hidden;max-width:100%;border-radius:12px"
          scrolling="no"
          frameborder="0"
          allowfullscreen="true"
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"></iframe>
      `;
      giveConsent();
    }
  }

  // Give Consent
  function giveConsent() {
    consentGiven = true;
    localStorage.setItem('socialMediaConsent', 'true');
  }

  // Video Player Modal
  function openVideoModal(videoId, startSeconds = 0) {
    const modal = document.getElementById('video-modal');
    const player = document.getElementById('video-modal-player');
    
    if (modal && player) {
      const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&start=${startSeconds}&rel=0`;
      player.innerHTML = `
        <iframe 
          src="${embedUrl}"
          title="YouTube ভিডিও প্লেয়ার"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"></iframe>
      `;
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      
      // Focus trap
      modal.focus();
    }
  }

  function closeVideoModal() {
    const modal = document.getElementById('video-modal');
    const player = document.getElementById('video-modal-player');
    
    if (modal && player) {
      modal.style.display = 'none';
      player.innerHTML = '';
      document.body.style.overflow = '';
    }
  }

  // Video Card Click Handlers
  document.querySelectorAll('.yt-video-card').forEach(card => {
    card.addEventListener('click', () => {
      const videoId = card.getAttribute('data-video-id');
      const startSeconds = parseInt(card.getAttribute('data-start') || '0');
      if (videoId) {
        openVideoModal(videoId, startSeconds);
      }
    });
  });

  // Modal Keyboard Controls
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeVideoModal();
    }
  });

  // Tab Navigation
  document.querySelectorAll('.social-tab').forEach(tab => {
    tab.addEventListener('click', (e) => {
      e.preventDefault();
      const target = tab.getAttribute('href');
      if (target) {
        document.querySelector(target)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        
        // Update active state
        document.querySelectorAll('.social-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
      }
    });
  });

  // Update Active Tab on Scroll
  const observerForTabs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        document.querySelectorAll('.social-tab').forEach(tab => {
          tab.classList.remove('active');
          if (tab.getAttribute('href') === `#${id}`) {
            tab.classList.add('active');
          }
        });
      }
    });
  }, { threshold: 0.3 });

  document.querySelectorAll('.social-section').forEach(section => {
    observerForTabs.observe(section);
  });

  // Auto-load if consent already given
  if (consentGiven) {
    const loadOnScroll = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const platform = entry.target.getAttribute('data-platform');
          if (platform === 'facebook-main' && !document.getElementById('facebook-main-embed')?.innerHTML) {
            loadFacebookMain();
          } else if (platform === 'facebook-vod' && !document.getElementById('facebook-vod-embed')?.innerHTML) {
            loadFacebookVOD();
          }
          loadOnScroll.unobserve(entry.target);
        }
      });
    }, { rootMargin: '100px' });

    document.querySelectorAll('[data-platform^="facebook"]').forEach(el => {
      loadOnScroll.observe(el);
    });
  }

  // Make functions global
  window.loadFacebookMain = loadFacebookMain;
  window.loadFacebookVOD = loadFacebookVOD;
  window.closeVideoModal = closeVideoModal;
</script>
</BaseLayout>
