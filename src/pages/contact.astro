---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../data/site.json';

const title = 'যোগাযোগ | মাহফুজ কবির মুক্তা';
const description = 'মাহফুজ কবির মুক্তার সাথে যোগাযোগ করুন। প্রশ্ন, পরামর্শ বা সহযোগিতার জন্য আমাদের সাথে সংযুক্ত হোন।';
---

<BaseLayout title={title} description={description}>
  <!-- Breadcrumbs -->
  <section class="breadcrumbs">
    <div class="wrap">
      <nav aria-label="Breadcrumb">
        <ol>
          <li><a href="/">হোম</a></li>
          <li>যোগাযোগ</li>
        </ol>
      </nav>
    </div>
  </section>

  <!-- Contact Section -->
  <section>
    <div class="wrap" style="max-width:980px">
      <div style="text-align:center;margin-bottom:48px">
        <span class="eyebrow">যোগাযোগ</span>
        <h1 class="h2" style="font-size:clamp(32px,5vw,48px)">আমাদের সাথে সংযুক্ত হোন</h1>
        <p class="lead" style="margin:16px auto 0">
          যেকোনো প্রশ্ন, পরামর্শ, মিডিয়া ইনকোয়ারি বা সহযোগিতার জন্য আমাদের সাথে যোগাযোগ করুন।
        </p>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1.2fr;gap:48px;align-items:start">
        <!-- Contact Info -->
        <div class="rv">
          <div style="background:var(--card);padding:32px;border-radius:var(--r);box-shadow:var(--sh);margin-bottom:24px">
            <h3 style="font-size:22px;color:var(--g8);margin-bottom:20px">যোগাযোগের তথ্য</h3>
            
            <div style="display:flex;flex-direction:column;gap:20px">
              <div style="display:flex;gap:16px;align-items:start">
                <div style="width:48px;height:48px;background:var(--cream);border-radius:12px;display:grid;place-items:center;color:var(--g8);flex-shrink:0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </div>
                <div>
                  <strong style="display:block;color:var(--g8);margin-bottom:4px">ঠিকানা</strong>
                  <p style="color:var(--mut);font-size:15px">{siteData.address.bn}</p>
                </div>
              </div>

              {siteData.phone && siteData.phone !== '[NEEDS OWNER INPUT]' && (
                <div style="display:flex;gap:16px;align-items:start">
                  <div style="width:48px;height:48px;background:var(--cream);border-radius:12px;display:grid;place-items:center;color:var(--g8);flex-shrink:0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                  </div>
                  <div>
                    <strong style="display:block;color:var(--g8);margin-bottom:4px">ফোন</strong>
                    <p style="color:var(--mut);font-size:15px">
                      <a href={`tel:${siteData.phone}`}>{siteData.phoneBN || siteData.phone}</a>
                    </p>
                  </div>
                </div>
              )}

              {siteData.email && siteData.email !== '[NEEDS OWNER INPUT]' && (
                <div style="display:flex;gap:16px;align-items:start">
                  <div style="width:48px;height:48px;background:var(--cream);border-radius:12px;display:grid;place-items:center;color:var(--g8);flex-shrink:0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                  </div>
                  <div>
                    <strong style="display:block;color:var(--g8);margin-bottom:4px">ইমেইল</strong>
                    <p style="color:var(--mut);font-size:15px">
                      <a href={`mailto:${siteData.email}`}>{siteData.email}</a>
                    </p>
                  </div>
                </div>
              )}
            </div>
          </div>

          <!-- Map Card -->
          <div style="background:var(--card);padding:28px;border-radius:var(--r);box-shadow:var(--sh);margin-bottom:24px">
            <h4 style="font-size:18px;color:var(--g8);margin-bottom:16px;display:flex;align-items:center;gap:8px">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              মানচিত্রে দেখুন
            </h4>
            <p style="color:var(--mut);font-size:14px;margin-bottom:16px;line-height:1.6;white-space:pre-line">{siteData.address.bn}</p>
            <a 
              href={siteData.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline"
              style="width:100%;justify-content:center"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="10" r="3"></circle>
                <path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 6.9 8 11.7z"></path>
              </svg>
              Google Maps-এ খুলুন
            </a>
          </div>

          <!-- Social Links -->
          <div style="background:var(--g8);padding:28px;border-radius:var(--r);color:#fff">
            <h4 style="font-size:18px;margin-bottom:16px">সোশ্যাল মিডিয়া</h4>
            <div class="soc" style="gap:12px">
              <a href={siteData.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" style="width:44px;height:44px">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
              <a href={siteData.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" style="width:44px;height:44px">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </a>
              <a href={siteData.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" style="width:44px;height:44px">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
              <a href={siteData.social.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" style="width:44px;height:44px">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="rv">
          <form 
            method="POST"
            action={siteData.forms.contact || `mailto:${siteData.forms.contactEmail}`}
            style="background:var(--card);padding:36px;border-radius:var(--r);box-shadow:var(--sh)"
            id="contactForm"
          >
            <h3 style="font-size:22px;color:var(--g8);margin-bottom:24px">বার্তা পাঠান</h3>
            
            <!-- Honeypot for spam protection -->
            <div style="position:absolute;left:-5000px" aria-hidden="true">
              <input type="text" name="honeypot" tabindex="-1" autocomplete="off" />
            </div>

            <div style="display:flex;flex-direction:column;gap:20px">
              <div>
                <label for="name" style="display:block;font-weight:600;color:var(--g8);margin-bottom:8px">
                  নাম <span style="color:var(--gold)">*</span>
                </label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  style="width:100%;padding:14px 18px;border:2px solid #e0e0e0;border-radius:12px;font:inherit;transition:border-color 0.2s"
                  onfocus="this.style.borderColor='var(--gold)'"
                  onblur="this.style.borderColor='#e0e0e0'"
                />
              </div>

              <div>
                <label for="email" style="display:block;font-weight:600;color:var(--g8);margin-bottom:8px">
                  ইমেইল <span style="color:var(--gold)">*</span>
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  style="width:100%;padding:14px 18px;border:2px solid #e0e0e0;border-radius:12px;font:inherit;transition:border-color 0.2s"
                  onfocus="this.style.borderColor='var(--gold)'"
                  onblur="this.style.borderColor='#e0e0e0'"
                />
              </div>

              <div>
                <label for="phone" style="display:block;font-weight:600;color:var(--g8);margin-bottom:8px">
                  ফোন
                </label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  style="width:100%;padding:14px 18px;border:2px solid #e0e0e0;border-radius:12px;font:inherit;transition:border-color 0.2s"
                  onfocus="this.style.borderColor='var(--gold)'"
                  onblur="this.style.borderColor='#e0e0e0'"
                />
              </div>

              <div>
                <label for="subject" style="display:block;font-weight:600;color:var(--g8);margin-bottom:8px">
                  বিষয় <span style="color:var(--gold)">*</span>
                </label>
                <input 
                  type="text" 
                  id="subject" 
                  name="subject" 
                  required 
                  style="width:100%;padding:14px 18px;border:2px solid #e0e0e0;border-radius:12px;font:inherit;transition:border-color 0.2s"
                  onfocus="this.style.borderColor='var(--gold)'"
                  onblur="this.style.borderColor='#e0e0e0'"
                />
              </div>

              <div>
                <label for="message" style="display:block;font-weight:600;color:var(--g8);margin-bottom:8px">
                  বার্তা <span style="color:var(--gold)">*</span>
                </label>
                <textarea 
                  id="message" 
                  name="message" 
                  required 
                  rows="5"
                  style="width:100%;padding:14px 18px;border:2px solid #e0e0e0;border-radius:12px;font:inherit;resize:vertical;transition:border-color 0.2s"
                  onfocus="this.style.borderColor='var(--gold)'"
                  onblur="this.style.borderColor='#e0e0e0'"
                ></textarea>
              </div>

              <button type="submit" class="btn btn-gold" style="justify-content:center">
                বার্তা পাঠান
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
              </button>
            </div>

            <p style="margin-top:16px;font-size:13px;color:var(--mut);text-align:center">
              আপনার তথ্য সুরক্ষিত এবং গোপনীয় রাখা হবে।
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @media (max-width: 900px) {
    section > .wrap > div[style*="grid-template-columns"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', async (e) => {
      const honeypot = (form.querySelector('[name="honeypot"]') as HTMLInputElement)?.value;
      if (honeypot) {
        e.preventDefault();
        return;
      }
      
      // Add your form submission logic here
      // If using Formspree or similar, the form will submit naturally
    });
  }
</script>
